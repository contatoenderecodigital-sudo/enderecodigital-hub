# Conexao com o Postgres self-hosted (host = nome do container na rede coolify)
DATABASE_URL=postgres://hub:senha@host:5432/enderecodigital_hub
# Segredo pra assinar a sessao (JWT). Gere com: openssl rand -hex 32
SESSION_SECRET=troque-isto
# Bootstrap (seed) do owner + hub. Chame /api/bootstrap?token=... uma vez.
BOOTSTRAP_TOKEN=troque-isto
OWNER_EMAIL=contato@enderecodigital.com
OWNER_PASSWORD=troque-isto
