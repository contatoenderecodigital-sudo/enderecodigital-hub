# Conexao com o Postgres self-hosted (host = nome do container na rede coolify)
DATABASE_URL=postgres://hub:senha@host:5432/enderecodigital_hub
# Segredo pra assinar a sessao (JWT). Gere com: openssl rand -hex 32
SESSION_SECRET=troque-isto
# Bootstrap (seed) do owner + hub. Chame /api/bootstrap?token=... uma vez.
BOOTSTRAP_TOKEN=troque-isto
OWNER_EMAIL=contato@enderecodigital.com
OWNER_PASSWORD=troque-isto

# ---- MySQL do GROOW (operacao, leads, clientes, parceiros) ----
MYSQL_HOST=hub-mysql
MYSQL_PORT=3306
MYSQL_USER=
MYSQL_PASSWORD=
MYSQL_DATABASE=enderecodigital

# ---- Programa de parceiros ----
# URL publica do hub: monta o link /p/codigo que o parceiro copia no painel.
APP_URL=https://enderecodigital.tech
# Numero da agencia no WhatsApp, so digitos com DDI. Sem isto o botao
# "Chamar no WhatsApp" da landing de indicacao nao aparece.
WHATSAPP_NUMERO_PUBLICO=5549999999999

# ---- Copiloto de call (desligado por padrao) ----
# Ligue com 1 quando houver chave. Precisa das DUAS chaves abaixo pra funcionar:
# Gemini transcreve o audio, Claude gera a sugestao de fala.
COPILOTO_IA_ATIVO=0
# COPILOTO_MODELO=claude-haiku-4-5

# ---- WhatsApp Cloud API (envio pela agencia) ----
# Sem estas, o botao "Disparar" da ficha do parceiro promove o lead mas
# nao envia a mensagem.
WHATSAPP_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_WABA_ID=
WHATSAPP_VERIFY_TOKEN=
WHATSAPP_APP_SECRET=

# ---- IA ----
ANTHROPIC_API_KEY=
GEMINI_API_KEY=
